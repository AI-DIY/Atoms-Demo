[Unit]
Description=Agent Studio dedicated HTTP proxy (port 80 only)
After=network.target agent-studio.service

[Service]
Type=simple
ExecStartPre=/usr/sbin/nginx -t -c /opt/agent-studio/current/deploy/nginx.conf
ExecStart=/usr/sbin/nginx -c /opt/agent-studio/current/deploy/nginx.conf -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGQUIT
Restart=on-failure
MemoryMax=100M
CPUQuota=30%

[Install]
WantedBy=multi-user.target
